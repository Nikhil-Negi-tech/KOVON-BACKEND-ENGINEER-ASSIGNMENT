          ],
          "path": [
            "candidates"
          ]
        }
      }
    },
    {
      "name": "Create Candidate - Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob\",\n  \"skill_description\": \"Data engineer with Spark, SQL, and ETL pipelines\",\n  \"experience\": 7,\n  \"location\": \"Munich\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/candidates",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "candidates"
          ]
        }
      }
    },
    {
      "name": "Create Job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "if (response.id) {",
              "    pm.collectionVariables.set('job_id', response.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"country\": \"Germany\",\n  \"description\": \"Looking for a Python FastAPI backend engineer to build async microservices and REST APIs\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/jobs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "jobs"
          ]
        }
      }
    },
    {
      "name": "Match Candidates for Job",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/jobs/{{job_id}}/match",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "jobs",
            "{{job_id}}",
            "match"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "job_id",
      "value": ""
    }
  ]
}
